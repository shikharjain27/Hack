# Copy these into .env (never commit your real keys to git).

# Primary / Fallback AI Providers
GOOGLE_API_KEY=

# Ultra-Fast Provider (Groq / OpenAI / OpenRouter)
# For free, ultra-fast 500ms responses, get a free key at https://console.groq.com/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Optional: Supabase Auth & DB
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
